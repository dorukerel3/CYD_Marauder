# =====================================================================
# Firmware build artifacts (regenerated by build.sh)
# =====================================================================
/build/
/bin/

# Huge offline SD map tiles (several GB) — never commit
/sd folders/

# =====================================================================
# KiCad temp/backup files — SCOPED to the GPS PCB folder only, so they
# never strip files out of the firmware source/ or compile/ bundles.
# https://www.kicad.org/  — format docs: https://kicad.org/help/file-formats/
# =====================================================================
GPS-NEO_F10N-00B_Files/**/*.000
GPS-NEO_F10N-00B_Files/**/*.bak
GPS-NEO_F10N-00B_Files/**/*.bck
GPS-NEO_F10N-00B_Files/**/*.kicad_pcb-bak
GPS-NEO_F10N-00B_Files/**/*.kicad_sch-bak
GPS-NEO_F10N-00B_Files/**/*-backups
GPS-NEO_F10N-00B_Files/**/*-cache*
GPS-NEO_F10N-00B_Files/**/*-bak
GPS-NEO_F10N-00B_Files/**/*-bak*
GPS-NEO_F10N-00B_Files/**/*~
GPS-NEO_F10N-00B_Files/**/~*
GPS-NEO_F10N-00B_Files/**/_autosave-*
GPS-NEO_F10N-00B_Files/**/*.tmp
GPS-NEO_F10N-00B_Files/**/*-save.pro
GPS-NEO_F10N-00B_Files/**/*-save.kicad_pcb
GPS-NEO_F10N-00B_Files/**/fp-info-cache
GPS-NEO_F10N-00B_Files/**/~*.lck
GPS-NEO_F10N-00B_Files/**/*.net
GPS-NEO_F10N-00B_Files/**/*.dsn
GPS-NEO_F10N-00B_Files/**/*.ses
GPS-NEO_F10N-00B_Files/**/*-backups/*.zip
GPS-NEO_F10N-00B_Files/**/.history
GPS-NEO_F10N-00B_Files/**/*.kicad_prl
